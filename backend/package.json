{
  "name": "industrial-elogbook-backend",
  "version": "1.0.0",
  "description": "Backend for Industrial E-Logbook & Asset Registry Platform",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:integration": "npm run build && node --test integration/*.test.cjs",
    "test:restore:ci": "npm run build && node scripts/verify-backup-restore.cjs",
    "test:load:ci": "npm run build && node scripts/verify-synthetic-load.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
