PORT=5000
# Default fail-closed API bind for standalone local development:
API_BIND_HOST=127.0.0.1
# Use PLANTLOG_INTERNAL_CONTAINER_NETWORK only with a separately protected
# private container network and localhost-only host port mappings.
# PLANTLOG_INTERNAL_CONTAINER_NETWORK=true
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/plantlog
JWT_SECRET=
JWT_EXPIRE=7d
REGISTRATION_ENABLED=true
# Optional: replace default localhost CORS origins, comma-separated exact origins
# CORS_ORIGINS=https://demo.example.org
